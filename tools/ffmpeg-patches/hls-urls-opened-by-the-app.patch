--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -665,6 +665,14 @@
     if (!proto_name)
         proto_name = avio_find_protocol_name(url);
 
+    /* FramePlayerX builds no network protocols: its io_open callback opens
+     * http(s) playlists and segments itself, so they are let through by
+     * scheme. Without such a callback they fail to open as before. */
+    if (!proto_name && av_strstart(url, "https:", NULL))
+        proto_name = "https";
+    else if (!proto_name && av_strstart(url, "http:", NULL))
+        proto_name = "http";
+
     if (!proto_name)
         return AVERROR_INVALIDDATA;
 
